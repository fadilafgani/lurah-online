# =============================================================================
# Konfigurasi produksi — salin ke .env di VPS lalu isi nilainya
#   cp .env.production.example .env && nano .env
# JANGAN commit file .env ke git.
# =============================================================================

# --- Aplikasi ----------------------------------------------------------------
APP_NAME="Lurah Online"
APP_ENV=production
# Hasilkan dengan: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://lurah-online.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Deployment (dipakai docker-compose & Caddy, bukan Laravel) --------------
# Domain yang dilayani Caddy. Caddy hanya melayani HTTP di port 80 —
# HTTPS diterminasi oleh proxy di depan (Cloudflare / Nginx / load balancer).
APP_DOMAIN=lurah-online.example.com
# Rentang IP proxy yang dipercaya untuk header X-Forwarded-*, dipisah spasi.
#   - proxy di host yang sama (Nginx/Traefik lokal) -> private_ranges
#   - Cloudflare -> daftar dari https://www.cloudflare.com/ips/
TRUSTED_PROXIES=private_ranges
# Port host yang dipetakan ke port 80 container. Ubah bila ada proxy lain
# yang sudah memakai port 80 di host (misal 8080).
WEB_HTTP_PORT=80
# Jalankan `php artisan migrate --force` otomatis saat container start
RUN_MIGRATIONS=true

# --- Log ---------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL eksternal / Aiven) --------------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session / Cache / Queue -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Kosongkan atau isi domain agar cookie hanya berlaku di domain tersebut
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# --- Email -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite --------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
